<div class="space-y-4">
  <%= render "settings/providers/setup_steps",
             steps: [
               t("settings.providers.priorbank_panel.step_1"),
               t("settings.providers.priorbank_panel.step_2"),
               t("settings.providers.priorbank_panel.step_3")
             ] %>

  <% error_msg = local_assigns[:error_message] || @error_message %>
  <% if error_msg.present? %>
    <%= render DS::Alert.new(message: error_msg, variant: :error) %>
  <% end %>

  <%= styled_form_with model: PriorbankItem.new,
                       url: priorbank_items_path,
                       scope: :priorbank_item,
                       method: :post,
                       data: { turbo: true },
                       class: "space-y-3" do |form| %>
    <%= form.text_field :name,
                        label: t("settings.providers.priorbank_panel.name_label"),
                        placeholder: t("settings.providers.priorbank_panel.name_placeholder") %>

    <%= form.text_field :login,
                        label: t("settings.providers.priorbank_panel.login_label"),
                        placeholder: t("settings.providers.priorbank_panel.login_placeholder") %>

    <%= form.text_field :password,
                        label: t("settings.providers.priorbank_panel.password_label"),
                        placeholder: t("settings.providers.priorbank_panel.password_placeholder"),
                        type: :password %>

    <div class="flex justify-end">
      <%= form.submit t("settings.providers.priorbank_panel.save_button") %>
    </div>
  <% end %>

  <% priorbank_items = @priorbank_items || Current.family.priorbank_items.ordered %>

  <% if priorbank_items.any? %>
    <div class="space-y-2 mt-2">
      <% priorbank_items.each do |item| %>
        <div class="flex items-center justify-between p-3 bg-surface-inset rounded-xl">
          <div class="flex-1 min-w-0">
            <p class="text-sm font-medium text-primary truncate"><%= item.name %></p>
            <p class="text-xs text-secondary"><%= t("settings.providers.priorbank_panel.login_display", login: item.login&.first(4)) %></p>
          </div>
          <% if item.scheduled_for_deletion %>
            <p class="text-xs text-warning ml-3"><%= t("settings.providers.priorbank_panel.scheduled_for_deletion") %></p>
          <% else %>
            <%= button_to priorbank_item_path(item),
                          method: :delete,
                          class: "ml-3 text-destructive hover:text-destructive/80 transition-colors",
                          data: { turbo: true, turbo_confirm: t("settings.providers.priorbank_panel.delete_confirm") } do %>
              <%= icon "trash-2", size: "sm" %>
            <% end %>
          <% end %>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="text-sm text-secondary"><%= t("settings.providers.priorbank_panel.no_connections") %></p>
  <% end %>
</div>
